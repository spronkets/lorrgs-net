{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "API: restore",
      "type": "shell",
      "command": "dotnet",
      "args": ["restore", "Lorrgs.Api/Lorrgs.Api.csproj"],
      "group": "build"
    },
    {
      "label": "API: build",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "Lorrgs.Api/Lorrgs.Api.csproj"],
      "group": "build",
      "dependsOn": ["API: restore"],
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "API: run",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "Lorrgs.Api.csproj",
        "--no-build",
        "--no-launch-profile"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Lorrgs.Api",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5247"
        }
      },
      "dependsOn": ["API: build"],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "custom",
        "severity": "info",
        "pattern": {
          "regexp": "a^",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building...",
          "endsPattern": "Now listening on:"
        }
      }
    },
    {
      "label": "Web: install",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "options": {
        "cwd": "${workspaceFolder}/lorrgs-web"
      }
    },
    {
      "label": "Web: test",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test"],
      "options": {
        "cwd": "${workspaceFolder}/lorrgs-web"
      },
      "group": "test"
    },
    {
      "label": "Web: format",
      "type": "shell",
      "command": "npm",
      "args": ["run", "format"],
      "options": {
        "cwd": "${workspaceFolder}/lorrgs-web"
      }
    },
    {
      "label": "Web: format write",
      "type": "shell",
      "command": "npm",
      "args": ["run", "format:write"],
      "options": {
        "cwd": "${workspaceFolder}/lorrgs-web"
      }
    },
    {
      "label": "Web: lint",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint"],
      "options": {
        "cwd": "${workspaceFolder}/lorrgs-web"
      }
    },
    {
      "label": "Web: dev server",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/lorrgs-web"
      },
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "custom",
        "severity": "info",
        "pattern": {
          "regexp": "a^",
          "message": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> lorrgs-web@.* dev|^> vite --host",
          "endsPattern": "(Local:\\s+http://localhost:5173/|ready in .*ms)"
        }
      }
    },
    {
      "label": "Web: start dev",
      "dependsOrder": "sequence",
      "dependsOn": ["Web: dev server"],
      "runOptions": {
        "reevaluateOnRerun": true
      }
    },
    {
      "label": "Dev: run full stack",
      "dependsOrder": "sequence",
      "dependsOn": ["API: run", "Web: start dev"]
    },
    {
      "label": "Docker: compose up",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "up", "--build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true
    },
    {
      "label": "Docker: compose down",
      "type": "shell",
      "command": "docker",
      "args": ["compose", "down"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
